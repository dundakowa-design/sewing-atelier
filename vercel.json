{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["static/**", "templates/**"]
      }
    },
    {
      "src": "api/submit.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/bot.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/submit",
      "dest": "api/submit.js"
    },
    {
      "src": "/api/bot",
      "dest": "api/bot.js"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
